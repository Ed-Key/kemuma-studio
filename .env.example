# Etsy
# Identifies the app to the Etsy API.
ETSY_KEYSTRING=
# Authenticates the app to the Etsy API.
ETSY_SHARED_SECRET=

# Model API keys
# Gives writer and staging code access to OpenAI models.
OPENAI_API_KEY=
# Required. The default writer uses Gemini and fails when this is blank.
GEMINI_API_KEY=
# Gives writer code access to Anthropic models.
ANTHROPIC_API_KEY=
# Gives writer code access to xAI models.
XAI_API_KEY=

# Model selection
# Selects the primary writer model.
WRITER_MODEL=
# Selects the staged image provider.
IMAGE_PROVIDER=
# Selects the product matcher model.
MATCHER_MODEL=
# Selects the staging art director model.
ART_DIRECTOR_MODEL=
# Selects the staging agent model.
STAGING_AGENT_MODEL=
# Lists the writer models compared by the bake-off script.
BAKEOFF_MODELS=
# Selects the Anthropic model used by direct generation paths.
ANTHROPIC_MODEL=
